# PostgreSQL 连接地址（必填）
DATABASE_URL=postgres://user:password@localhost:5432/agent_market

# JWT 密钥（生产环境务必修改）
JWT_SECRET=dev-secret

# JWT 有效期
JWT_EXPIRES_IN=7d

# 登录 nonce 过期时间（秒）
NONCE_TTL_SECONDS=300

# 服务端口
PORT=3000

# Agent 执行地址白名单（可选，逗号分隔 host）
# 例如：agent.example.com,api.agent.local
ALLOWED_AGENT_HOSTS=

# 链上事件同步（测试网示例）
# 链 ID（Sepolia）
CHAIN_ID=11155111
# RPC 地址（HTTP）
RPC_URL=
# 合约地址（事件来源）
CONTRACT_ADDRESS=
# 起始区块（建议填合约部署块或当前块）
START_BLOCK=
# 轮询间隔（毫秒）
POLL_INTERVAL_MS=15000
